[10.191737, "o", "\u001b[?2004hroot@3468d52e6b7f:/app# "]
[11.951255, "i", "cat services/api/app.py\n"]
[11.951896, "o", "cat services/api/app.py\r\n\u001b[?2004l\r"]
[11.952442, "o", "from flask import Flask, jsonify, request\r\nfrom sqlalchemy import create_engine, text\r\nimport redis\r\nimport os\r\nimport json\r\nimport time\r\n\r\napp = Flask(__name__)\r\n\r\n# Bug 1: wrong env var — should be DATABASE_URL\r\nengine = create_engine(os.environ.get(\"DB_URL\", \"sqlite:////tmp/taskdb.sqlite\"))\r\nredis_client = redis.from_url(os.environ.get(\"REDIS_URL\", \"redis://localhost:6379\"))\r\n\r\ndef init_db():\r\n    with engine.connect() as conn:\r\n        conn.execute(text(\"\"\"\r\n            CREATE TABLE IF NOT EXISTS jobs (\r\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\r\n                payload TEXT NOT NULL,\r\n                status TEXT DEFAULT 'pending',\r\n                priority INTEGER DEFAULT 0,\r\n                created_at TEXT DEFAULT (datetime('now')),\r\n                processed_at TEXT\r\n            )\r\n        \"\"\"))\r\n        conn.commit()\r\n\r\n@app.route(\"/health\")\r\ndef health():\r\n    try:\r\n        with engine.connect() as conn:\r\n            conn.execute(text(\"SELECT 1\"))\r\n        redis_client.ping()\r\n        return jsonify({\"status\": \"healthy\", \"db\": \"ok\", \"redis\": \"ok\"})\r\n    except Exception as e:\r\n        return jsonify({\"status\": \"unhealthy\", \"error\": str(e)}), 500\r\n\r\n@app.route(\"/jobs\", methods=[\"POST\"])\r\ndef create_job():\r\n    data = request.get_json()\r\n    if not data or \"payload\" not in data:\r\n        return jsonify({\"error\": \"payload required\"}), 400\r\n    priority = data.get(\"priority\", 0)\r\n    if not isinstance(priority, int):\r\n        return jsonify({\"error\": \"priority must be integer\"}), 400\r\n    with engine.connect() as conn:\r\n        result = conn.execute(\r\n            text(\"INSERT INTO jobs (payload, priority) VALUES (:payload, :priority)\"),\r\n            {\"payload\": data[\"payload\"], \"priority\": priority}\r\n        )\r\n        conn.commit()\r\n        job_id = result.lastrowid\r\n    # Bug 2: wrong queue name\r\n    redis_client.lpush(\"jobs\", json.dumps({\"id\": job_id, \"payload\": data[\"payload\"], \"priority\": priority}))\r\n    return jsonify({\"id\": job_id, \"status\": \"pending\"}), 201\r\n\r\n@app.route(\"/jobs/<int:job_id>\")\r\ndef get_job(job_id):\r\n    with engine.connect() as conn:\r\n        result = conn.execute(\r\n            text(\"SELECT id, payload, status, priority, created_at FROM jobs WHERE id = :id\"),\r\n            {\"id\": job_id}\r\n        )\r\n        row = result.fetchone()\r\n    if not row:\r\n        return jsonify({\"error\": \"not found\"}), 404\r\n    return jsonify({\"id\": row[0], \"payload\": row[1], \"status\": row[2], \"priority\": row[3], \"created_at\": str(row[4])})\r\n\r\n@app.route(\"/jobs\")\r\ndef list_jobs():\r\n    status = request.args.get(\"status\")\r\n    with engine.connect() as conn:\r\n        if status:\r\n            # Bug 3: ASC should be DESC\r\n            result = conn.execute(\r\n                text(\"SELECT id, payload, status, priority FROM jobs WHERE status = :status ORDER BY priority ASC\"),\r\n                {\"status\": status}\r\n            )\r\n        else:\r\n            result = conn.execute(text(\"SELECT id, payload, status, priority FROM jobs ORDER BY created_at DESC\"))\r\n        rows = result.fetchall()\r\n    return jsonify([{\"id\": r[0], \"payload\": r[1], \"status\": r[2], \"priority\": r[3]} for r in rows])\r\n\r\n@app.route(\"/stats\")\r\ndef stats():\r\n    with engine.connect() as conn:\r\n        result = conn.execute(text(\"SELECT status, COUNT(*) FROM jobs GROUP BY status\"))\r\n        rows = result.fetchall()\r\n    return jsonify({row[0]: row[1] for row in rows})\r\n\r\nif __name__ == \"__main__\":\r\n    init_db()\r\n    app.run(host=\"0.0.0.0\", port=8000, debug=False)\r\n"]
[11.953029, "o", "\u001b[?2004hroot@3468d52e6b7f:/app# "]
[13.625165, "i", "cat services/worker/worker.py\n"]
[13.626337, "o", "cat services/worker/worker.py\r\n\u001b[?2004l\r"]
[13.626674, "o", "import redis\r\nimport json\r\nimport os\r\nimport time\r\nfrom sqlalchemy import create_engine, text\r\n\r\nredis_client = redis.from_url(os.environ.get(\"REDIS_URL\", \"redis://localhost:6379\"))\r\nengine = create_engine(os.environ.get(\"DATABASE_URL\", \"sqlite:////tmp/taskdb.sqlite\"))\r\n\r\ndef process_job(job_data):\r\n    job_id = job_data[\"id\"]\r\n    time.sleep(0.1)\r\n    with engine.connect() as conn:\r\n        # Bug 4: wrong status — should be 'completed'\r\n        conn.execute(\r\n            text(\"UPDATE jobs SET status = 'done', processed_at = datetime('now') WHERE id = :id\"),\r\n            {\"id\": job_id}\r\n        )\r\n        conn.commit()\r\n    print(f\"Job {job_id} processed\")\r\n\r\ndef main():\r\n    print(\"Worker listening on job_queue...\")\r\n    while True:\r\n        try:\r\n            result = redis_client.brpop(\"job_queue\", timeout=5)\r\n            if result:\r\n                _, data = result\r\n                process_job(json.loads(data))\r\n        except Exception as e:\r\n            print(f\"Worker error: {e}\")\r\n            time.sleep(1)\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
[13.627323, "o", "\u001b[?2004hroot@3468d52e6b7f:/app# "]
[15.216325, "i", "cat services/scheduler/scheduler.py\n"]
[15.217386, "o", "cat services/scheduler/scheduler.py\r\n\u001b[?2004l\r"]
[15.219865, "o", "import requests\r\nimport redis\r\nimport schedule\r\nimport time\r\nimport os\r\n\r\nAPI_URL = os.environ.get(\"API_URL\", \"http://localhost:8000\")\r\nredis_client = redis.from_url(os.environ.get(\"REDIS_URL\", \"redis://localhost:6379\"))\r\n\r\ndef submit_scheduled_jobs():\r\n    payloads = [\"health_check\", \"cleanup_old_records\", \"generate_report\"]\r\n    for i, payload in enumerate(payloads):\r\n        try:\r\n            # Bug 5: priority is str not int\r\n            r = requests.post(f\"{API_URL}/jobs\", json={\"payload\": payload, \"priority\": str(i)}, timeout=5)\r\n            print(f\"Scheduled {payload}: {r.status_code} {r.text}\")\r\n        except Exception as e:\r\n            print(f\"Scheduler error: {e}\")\r\n\r\ndef check_queue_depth():\r\n    depth = redis_client.llen(\"job_queue\")\r\n    # Bug 6: stores as string — should be int\r\n    redis_client.set(\"queue_depth\", str(depth))\r\n\r\nschedule.every(30).seconds.do(submit_scheduled_jobs)\r\nschedule.every(10).seconds.do(check_queue_depth)\r\n\r\nif __name__ == \"__main__\":\r\n    time.sleep(8)\r\n    print(\"Scheduler started\")\r\n    submit_scheduled_jobs()\r\n    while True:\r\n        schedule.run_pending()\r\n        time.sleep(1)\r\n"]
