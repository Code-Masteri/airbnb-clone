[8.951691, "o", "cat /app/services/worker/worker.py\r\n\u001b[?2004l\r"]
[8.952657, "o", "import redis\r\nimport json\r\nimport os\r\nimport time\r\nfrom sqlalchemy import create_engine, text\r\n\r\nredis_client = redis.from_url(os.environ.get(\"REDIS_URL\", \"redis://localhost:6379\"))\r\nengine = create_engine(os.environ.get(\"DATABASE_URL\", \"sqlite:////tmp/taskdb.sqlite\"))\r\n\r\ndef process_job(job_data):\r\n    job_id = job_data[\"id\"]\r\n    time.sleep(0.1)\r\n    with engine.connect() as conn:\r\n        # Bug 4: wrong status — should be 'completed'\r\n        conn.execute(\r\n            text(\"UPDATE jobs SET status = 'done', processed_at = datetime('now') WHERE id = :id\"),\r\n            {\"id\": job_id}\r\n        )\r\n        conn.commit()\r\n    print(f\"Job {job_id} processed\")\r\n\r\ndef main():\r\n    print(\"Worker listening on job_queue...\")\r\n    while True:\r\n        try:\r\n            result = redis_client.brpop(\"job_queue\", timeout=5)\r\n            if result:\r\n                _, data = result\r\n                process_job(json.loads(data))\r\n        except Exception as e:\r\n            print(f\"Worker error: {e}\")\r\n            time.sleep(1)\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
