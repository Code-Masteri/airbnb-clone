# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Core Dependencies
/node_modules
/.pnp
.pnp.*

# Yarn v2/v3/v4 Zero-Installs
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
!.yarn/sdks
!.yarn/cache

# Alternative Package Managers (pnpm / bun)
.pnpm-store/
/pnpm-lock.yaml
/bun.lockb

# Testing & Coverage
/coverage
/.nyc_output
junit.xml
*.lcov

# Next.js Framework & Bundlers
/.next/
/out/
/.turbo/
.parcel-cache/

# Production Builds
/build
/dist

# Operating System Garbage
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# IDEs and Code Editors
.vscode/
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Debug & System Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Secrets & Environment Files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert

# Cloud Hosting & Deployment
.vercel
.netlify
.serverless/
App_Data/

# TypeScript Cache
*.tsbuildinfo
next-env.d.ts
