[29.407359, "o", "cat /app/services/scheduler/scheduler.py\r\n\u001b[?2004l\r"]
[29.409349, "o", "import requests\r\nimport redis\r\nimport schedule\r\nimport time\r\nimport os\r\n\r\nAPI_URL = os.environ.get(\"API_URL\", \"http://localhost:8000\")\r\nredis_client = redis.from_url(os.environ.get(\"REDIS_URL\", \"redis://localhost:6379\"))\r\n\r\ndef submit_scheduled_jobs():\r\n    payloads = [\"health_check\", \"cleanup_old_records\", \"generate_report\"]\r\n    for i, payload in enumerate(payloads):\r\n        try:\r\n            # Bug 5: priority is str not int\r\n            r = requests.post(f\"{API_URL}/jobs\", json={\"payload\": payload, \"priority\": str(i)}, timeout=5)\r\n            print(f\"Scheduled {payload}: {r.status_code} {r.text}\")\r\n        except Exception as e:\r\n            print(f\"Scheduler error: {e}\")\r\n\r\ndef check_queue_depth():\r\n    depth = redis_client.llen(\"job_queue\")\r\n    # Bug 6: stores as string — should be int\r\n    redis_client.set(\"queue_depth\", str(depth))\r\n\r\nschedule.every(30).seconds.do(submit_scheduled_jobs)\r\nschedule.every(10).seconds.do(check_queue_depth)\r\n\r\nif __name__ == \"__main__\":\r\n    time.sleep(8)\r\n    print(\"Scheduler started\")\r\n    submit_scheduled_jobs()\r\n    while True:\r\n        schedule.run_pending()\r\n        time.sleep(1)\r\n\u001b[?2004hroot@9f2243faa8bb:/app# "]
[40.480704, "i", "cat /app/services/worker/worker.py\n"]
[40.482962, "o", "cat /app/services/worker/worker.py\r\n\u001b[?2004l\r"]
[40.483819, "o", "import redis\r\nimport json\r\nimport os\r\nimport time\r\nfrom sqlalchemy import create_engine, text\r\n\r\nredis_client = redis.from_url(os.environ.get(\"REDIS_URL\", \"redis://localhost:6379\"))\r\nengine = create_engine(os.environ.get(\"DATABASE_URL\", \"sqlite:////tmp/taskdb.sqlite\"))\r\n\r\ndef process_job(job_data):\r\n    job_id = job_data[\"id\"]\r\n    time.sleep(0.1)\r\n    with engine.connect() as conn:\r\n        # Bug 4: wrong status — should be 'completed'\r\n        conn.execute(\r\n            text(\"UPDATE jobs SET status = 'done', processed_at = datetime('now') WHERE id = :id\"),\r\n            {\"id\": job_id}\r\n        )\r\n        conn.commit()\r\n    print(f\"Job {job_id} processed\")\r\n\r\ndef main():\r\n    print(\"Worker listening on job_queue...\")\r\n    while True:\r\n        try:\r\n            result = redis_client.brpop(\"job_queue\", timeout=5)\r\n            if result:\r\n                _, data = result\r\n                process_job(json.loads(data))\r\n        except Exception as e:\r\n            print(f\"Worker error: {e}\")\r\n            time.sleep(1)\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
