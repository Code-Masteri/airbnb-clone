[9.790854, "o", "total 16\r\ndrwxr-xr-x 2 root root 4096 Apr  4 07:13 .\r\ndrwxr-xr-x 5 root root 4096 Apr  3 21:53 ..\r\n-rw-r--r-- 1 root root   55 Apr  3 21:53 requirements.txt\r\n-rw-r--r-- 1 root root 1038 Apr  4 07:12 worker.py\r\n"]
