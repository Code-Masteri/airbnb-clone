[18.345002, "o", "total 16\r\ndrwxr-xr-x 2 root root 4096 Apr  3 21:53 .\r\ndrwxr-xr-x 5 root root 4096 Apr  3 21:53 ..\r\n-rw-r--r-- 1 root root   46 Apr  3 21:53 requirements.txt\r\n-rw-r--r-- 1 root root 1110 Apr  3 21:53 scheduler.py\r\n"]
