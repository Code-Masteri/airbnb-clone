[7.819096, "i", "cat api/app.py\n"]
[7.819665, "o", "cat api/app.py\r\n\u001b[?2004l\r"]
[7.820835, "o", "from flask import Flask, jsonify, request\r\nfrom sqlalchemy import create_engine, text\r\nimport redis\r\nimport os\r\nimport json\r\nimport time\r\n\r\napp = Flask(__name__)\r\n\r\n# Bug 1: wrong env var — should be DATABASE_URL\r\nengine = create_engine(os.environ.get(\"DB_URL\", \"sqlite:////tmp/taskdb.sqlite\"))\r\nredis_client = redis.from_url(os.environ.get(\"REDIS_URL\", \"redis://localhost:6379\"))\r\n\r\ndef init_db():\r\n    with engine.connect() as conn:\r\n        conn.execute(text(\"\"\"\r\n            CREATE TABLE IF NOT EXISTS jobs (\r\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\r\n                payload TEXT NOT NULL,\r\n                status TEXT DEFAULT 'pending',\r\n                priority INTEGER DEFAULT 0,\r\n                created_at TEXT DEFAULT (datetime('now')),\r\n                processed_at TEXT\r\n            )\r\n        \"\"\"))\r\n        conn.commit()\r\n\r\n@app.route(\"/health\")\r\ndef health():\r\n    try:\r\n        with engine.connect() as conn:\r\n            conn.execute(text(\"SELECT 1\"))\r\n        redis_client.ping()\r\n        return jsonify({\"status\": \"healthy\", \"db\": \"ok\", \"redis\": \"ok\"})\r\n    except Exception as e:\r\n        return jsonify({\"status\": \"unhealthy\", \"error\": str(e)}), 500\r\n\r\n@app.route(\"/jobs\", methods=[\"POST\"])\r\ndef create_job():\r\n    data = request.get_json()\r\n    if not data or \"payload\" not in data:\r\n        return jsonify({\"error\": \"payload required\"}), 400\r\n    priority = data.get(\"priority\", 0)\r\n    if not isinstance(priority, int):\r\n        return jsonify({\"error\": \"priority must be integer\"}), 400\r\n    with engine.connect() as conn:\r\n        result = conn.execute(\r\n            text(\"INSERT INTO jobs (payload, priority) VALUES (:payload, :priority)\"),\r\n            {\"payload\": data[\"payload\"], \"priority\": priority}\r\n        )\r\n        conn.commit()\r\n        job_id = result.lastrowid\r\n    # Bug 2: wrong queue name\r\n    redis_client.lpush(\"jobs\", json.dumps({\"id\": job_id, \"payload\": data[\"payload\"], \"priority\": priority}))\r\n    return jsonify({\"id\": job_id, \"status\": \"pending\"}), 201\r\n\r\n@app.route(\"/jobs/<int:job_id>\")\r\ndef get_job(job_id):\r\n    with engine.connect() as conn:\r\n        result = conn.execute(\r\n            text(\"SELECT id, payload, status, priority, created_at FROM jobs WHERE id = :id\"),\r\n            {\"id\": job_id}\r\n        )\r\n        row = result.fetchone()\r\n    if not row:\r\n        return jsonify({\"error\": \"not found\"}), 404\r\n    return jsonify({\"id\": row[0], \"payload\": row[1], \"status\": row[2], \"priority\": row[3], \"created_at\": str(row[4])})\r\n\r\n@app.route(\"/jobs\")\r\ndef list_jobs():\r\n    status = request.args.get(\"status\")\r\n    with engine.connect() as conn:\r\n        if status:\r\n            # Bug 3: ASC should be DESC\r\n            result = conn.execute(\r\n                text(\"SELECT id, payload, status, priority FROM jobs WHERE status = :status ORDER BY priority ASC\"),\r\n                {\"status\": status}\r\n            )\r\n        else:\r\n            result = conn.execute(text(\"SELECT id, payload, status, priority FROM jobs ORDER BY created_at DESC\"))\r\n        rows = result.fetchall()\r\n    return jsonify([{\"id\": r[0], \"payload\": r[1], \"status\": r[2], \"priority\": r[3]} for r in rows])\r\n\r\n@app.route(\"/stats\")\r\ndef stats():\r\n    with engine.connect() as conn:\r\n        result = conn.execute(text(\"SELECT status, COUNT(*) FROM jobs GROUP BY status\"))\r\n        rows = result.fetchall()\r\n    return jsonify({row[0]: row[1] for row in rows})\r\n\r\nif __name__ == \"__main__\":\r\n    init_db()\r\n    app.run(host=\"0.0.0.0\", port=8000, debug=False)\r\n\u001b[?2004hroot@7d217dbb9a50:/app/services# "]
