[13.364736, "o", "cat scheduler/scheduler.py\r\n\u001b[?2004l\r"]
[13.365723, "o", "import requests\r\nimport redis\r\nimport schedule\r\nimport time\r\nimport os\r\n\r\nAPI_URL = os.environ.get(\"API_URL\", \"http://localhost:8000\")\r\nredis_client = redis.from_url(os.environ.get(\"REDIS_URL\", \"redis://localhost:6379\"))\r\n\r\ndef submit_scheduled_jobs():\r\n    payloads = [\"health_check\", \"cleanup_old_records\", \"generate_report\"]\r\n    for i, payload in enumerate(payloads):\r\n        try:\r\n            # Bug 5: priority is str not int\r\n            r = requests.post(f\"{API_URL}/jobs\", json={\"payload\": payload, \"priority\": str(i)}, timeout=5)\r\n            print(f\"Scheduled {payload}: {r.status_code} {r.text}\")\r\n        except Exception as e:\r\n            print(f\"Scheduler error: {e}\")\r\n\r\ndef check_queue_depth():\r\n    depth = redis_client.llen(\"job_queue\")\r\n    # Bug 6: stores as string — should be int\r\n    redis_client.set(\"queue_depth\", str(depth))\r\n\r\nschedule.every(30).seconds.do(submit_scheduled_jobs)\r\nschedule.every(10).seconds.do(check_queue_depth)\r\n\r\nif __name__ == \"__main__\":\r\n    time.sleep(8)\r\n    print(\"Scheduler started\")\r\n    submit_scheduled_jobs()\r\n    while True:\r\n        schedule.run_pending()\r\n        time.sleep(1)\r\n\u001b[?2004hroot@13535fd84941:/app/services# "]
