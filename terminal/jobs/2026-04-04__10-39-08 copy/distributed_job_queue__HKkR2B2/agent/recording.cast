[35.05966, "o", "            # Fixed Bug 3: correct sorting order for high priority first\r\n\u001b[?2004l\r\u001b[?2004h>             result = conn.execute(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.059809, "o", "                text(\"SELECT id, payload, status, priority FROM jobs WHERE status = :status ORDER BY priority DESC\"),\r\n\u001b[?2004l\r\u001b[?2004h>                 {\"status\": status}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.059953, "o", "            )\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\n\u001b[?2004l\r"]
[35.060075, "o", "\u001b[?2004h> "]
[35.06039, "o", "            result = conn.execute(text(\"SELECT id, payload, status, priority FROM jobs ORDER BY created_at DESC\"))\r\n\u001b[?2004l\r\u001b[?2004h"]
[35.060433, "o", "> "]
[35.060554, "o", "        rows = result.fetchall()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.060645, "o", "    return jsonify([{\"id\": r[0], \"payload\": r[1], \"status\": r[2], \"priority\": r[3]} for r in rows])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.060745, "o", "@app.route(\"/stats\")\r\n\u001b[?2004l\r\u001b[?2004h> def stats():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.06084, "o", "    with engine.connect() as conn:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.060892, "o", "        result = conn.execute(text(\"SELECT status, COUNT(*) FROM jobs GROUP BY status\"))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.061051, "o", "        rows = result.fetchall()\r\n\u001b[?2004l\r\u001b[?2004h>     return jsonify({row[0]: row[1] for row in rows})\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.06116, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h>     init_db()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.06128, "o", "    app.run(host=\"0.0.0.0\", port=8000, debug=False)\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
